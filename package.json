{
  "name": "licencias-backend",
  "version": "0.1.0",
  "type": "module",
  "description": "Servicio comun de licencias de Sulotec: planes, cupos de usuarios, bolsas de tokens, consumo y avisos para todos los productos",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch src/servidor.js",
    "start": "node src/servidor.js",
    "test": "node --test --test-concurrency=1 \"tests/*.test.js\"",
    "token": "node scripts/token-producto.js",
    "tarea": "node scripts/tarea.js",
    "check": "node --check src/servidor.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "jose": "^6.0.0",
    "nodemailer": "^7.0.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "embedded-postgres": "^18.6.0-beta.19"
  }
}
