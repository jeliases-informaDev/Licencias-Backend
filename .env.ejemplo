# Copia este archivo como .env para correr en local (npm run dev). En el servidor vive en /opt/sulotec/licencias.env (lo crea el kit).
PORT=3200
DATABASE_URL=postgresql://postgres:prueba@localhost:55432/licencias
KEYCLOAK_ISSUER=https://cuenta.sulotec.com/realms/sulotec
KEYCLOAK_AUDIENCE=licencias
ROL_UNIVERSAL=administrador-general
CORS_ORIGENES=https://sulotec.com,http://localhost:4321
PORTAL_URL=https://sulotec.com
# Correo de salida (OCI Email Delivery). Vacio = los avisos solo se registran en el log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CORREO_REMITENTE=Sulotec <no-reply@sulotec.com>
CORREO_CONTACTO=contacto@sulotec.com
ZONA_HORARIA=America/Lima
TAREAS=1
